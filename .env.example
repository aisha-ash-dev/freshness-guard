# ===== COPY THIS FILE TO ".env" AND FILL IN THE VALUES (never commit .env) =====

# 1) PASTE YOUR TAVILY KEY HERE (starts with tvly-)  -> https://app.tavily.com
TAVILY_API_KEY=tvly-PASTE_YOUR_KEY_HERE

# 2) Where Bifrost is running (default for `npx -y @maximhq/bifrost`)
BIFROST_BASE_URL=http://localhost:8080
# Only fill this if you turned on authentication inside Bifrost, otherwise leave empty
BIFROST_API_KEY=

# 3) Models, written as provider/model (the provider must have a key added in the Bifrost UI)
#    ANSWER_MODEL = the model that answers questions in the demo
#    HELPER_MODEL = the model that extracts claims and judges evidence (cheap + fast is best)
ANSWER_MODEL=openai/gpt-4o-mini
HELPER_MODEL=openai/gpt-4o-mini

# ---- Optional tuning ----
RISK_THRESHOLD=0.4          # claims riskier than this get a live web check
MAX_CLAIMS_TO_VERIFY=5      # cap per answer (saves Tavily credits)
TAVILY_SEARCH_DEPTH=basic   # basic = 1 credit, advanced = 2 credits
CACHE_TTL_SECONDS=21600     # reuse verdicts for 6 hours
# TODAY_OVERRIDE=2026-11-12 # force the date used in prompts (testing only)
